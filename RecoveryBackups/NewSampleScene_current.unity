  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BuildingInfo
  buildingName: First Contact
  buildingRole: 2
  description: '"You do not find workers. Someone introduces them."


    This contact
    knows people who need money and know how to stay quiet. A worker costs you upfront,
    and every new face adds risk, but more hands make the operation earn more over
    time.'
  hasProductionControls: 1
  requiresPurchase: 0
  isPurchased: 0
  purchaseCost: 250
  purchaseButtonText: "Pay the contact (-250 \u20AC)"
  purchaseDescription: The contact will not move for free. Pay him first, and he
    opens the door to hiring workers later. Good introductions are expensive because
    silence is part of the price.
  showIncreaseAction: 1
  showDecreaseAction: 1
  actionsChangeLevel: 0
  actionCooldownEvents: 0
  productionLevel: 0
  minProductionLevel: 0
  maxProductionLevel: 3
  productionDescription: "Hire a worker for 220 \u20AC or fire one who is not busy.
    There is no daily wage. A worker is paid 15 \u20AC for each delivery and 15 \u20AC
    whenever production is started."
  statusName: Hired workers from contact
  neutralStatusText: none
  positiveStatusText: active
  negativeStatusText: none
  increaseButtonText: "Hire worker (-220 \u20AC, +worker)"
  decreaseButtonText: Fire worker (-worker, -risk)
